# Backend URL for the Expo app.
# On web (PC browser) or simulator: localhost works fine.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# On a PHYSICAL device (iOS/Android via Expo Go):
# Replace with your machine's local network IP.
# Find it with: ipconfig (Windows) or ifconfig | grep inet (Mac/Linux)
# EXPO_PUBLIC_BACKEND_URL=http://192.168.x.x:8000
